generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoomStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  MOVED_OUT
}

enum AssignmentStatus {
  ACTIVE
  CLOSED
}

enum DocumentType {
  AADHAAR
  PAN
  RENTAL_AGREEMENT
  OTHER
}

enum ElectricityMode {
  METER
  FIXED
  NONE
}

enum BillStatus {
  DRAFT
  GENERATED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillItemType {
  RENT
  ELECTRICITY
  CHARGE
  LATE_FEE
  DISCOUNT
  PREVIOUS_BALANCE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum ChargeType {
  MAINTENANCE
  WATER
  CLEANING
  INTERNET
  PARKING
  REPAIR
  LATE_FEE
  OTHER
  /// Piped gas bill (MNGL)
  MNGL_GAS
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions   Session[]
  properties Property[]
  auditLogs  AuditLog[]

  @@map("users")
}

/// Refresh-token sessions. Only a hash of the current refresh secret is stored.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash")
  /// Previous refresh secret, honoured for a short grace window so a lost response does not log the user out.
  prevTokenHash String?   @map("prev_token_hash")
  rotatedAt     DateTime? @map("rotated_at")
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Property {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerId            String   @map("owner_id") @db.Uuid
  name               String
  address            String
  city               String
  state              String
  pincode            String
  description        String?
  // Bill defaults (configured under Settings > Bill Settings)
  billPrefix         String   @default("INV") @map("bill_prefix")
  nextBillSeq        Int      @default(1) @map("next_bill_seq")
  dueDayOfMonth      Int      @default(10) @map("due_day_of_month")
  defaultRatePerUnit Decimal  @default(8) @map("default_rate_per_unit") @db.Decimal(8, 2)
  billFooterNote     String?  @map("bill_footer_note")
  /// UPI ID (VPA) printed as a "scan to pay" QR code on bills, e.g. name@bank.
  upiId              String?  @map("upi_id")
  /// Landlord phone printed under the address on bills (optional).
  contactPhone       String?  @map("contact_phone")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner   User     @relation(fields: [ownerId], references: [id])
  rooms   Room[]
  tenants Tenant[]
  bills   Bill[]

  @@index([ownerId])
  @@map("properties")
}

model Room {
  id               String          @id @default(uuid()) @db.Uuid
  propertyId       String          @map("property_id") @db.Uuid
  roomNumber       String          @map("room_number")
  floor            String?
  status           RoomStatus      @default(VACANT)
  defaultRent      Decimal         @default(0) @map("default_rent") @db.Decimal(12, 2)
  electricityMode  ElectricityMode @default(METER) @map("electricity_mode")
  ratePerUnit      Decimal?        @map("rate_per_unit") @db.Decimal(8, 2)
  fixedElectricity Decimal?        @map("fixed_electricity") @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  property    Property         @relation(fields: [propertyId], references: [id])
  assignments RoomAssignment[]
  bills       Bill[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, status])
  @@map("rooms")
}

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  propertyId       String       @map("property_id") @db.Uuid
  fullName         String       @map("full_name")
  phone            String
  alternatePhone   String?      @map("alternate_phone")
  email            String?
  permanentAddress String?      @map("permanent_address")
  currentAddress   String?      @map("current_address")
  emergencyContact String?      @map("emergency_contact")
  emergencyPhone   String?      @map("emergency_phone")
  occupation       String?
  joiningDate      DateTime     @map("joining_date") @db.Date
  notes            String?
  status           TenantStatus @default(ACTIVE)
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  property    Property         @relation(fields: [propertyId], references: [id])
  documents   TenantDocument[]
  assignments RoomAssignment[]
  bills       Bill[]
  payments    Payment[]

  @@index([propertyId, status])
  @@index([fullName])
  @@index([phone])
  @@map("tenants")
}

model TenantDocument {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  type       DocumentType
  label      String?
  storageKey String       @unique @map("storage_key")
  fileName   String       @map("file_name")
  mimeType   String       @map("mime_type")
  sizeBytes  Int          @map("size_bytes")
  deletedAt  DateTime?    @map("deleted_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@map("tenant_documents")
}

/// Tenant <-> room history. One ACTIVE assignment per room and per tenant
/// (enforced by partial unique indexes in the migration SQL).
model RoomAssignment {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  roomId              String           @map("room_id") @db.Uuid
  startDate           DateTime         @map("start_date") @db.Date
  endDate             DateTime?        @map("end_date") @db.Date
  agreedRent          Decimal          @map("agreed_rent") @db.Decimal(12, 2)
  securityDeposit     Decimal          @default(0) @map("security_deposit") @db.Decimal(12, 2)
  status              AssignmentStatus @default(ACTIVE)
  electricityMode     ElectricityMode  @default(METER) @map("electricity_mode")
  ratePerUnit         Decimal?         @map("rate_per_unit") @db.Decimal(8, 2)
  fixedElectricity    Decimal?         @map("fixed_electricity") @db.Decimal(12, 2)
  initialMeterReading Decimal?         @map("initial_meter_reading") @db.Decimal(12, 2)
  /// Balance owed before this system was used (e.g. migrated from a spreadsheet). Added to the first bill.
  openingBalance      Decimal          @default(0) @map("opening_balance") @db.Decimal(12, 2)
  finalMeterReading   Decimal?         @map("final_meter_reading") @db.Decimal(12, 2)
  moveOutNotes        String?          @map("move_out_notes")
  /// Rental agreement validity. Not the move-out date (endDate).
  agreementStartDate  DateTime?        @map("agreement_start_date") @db.Date
  agreementEndDate    DateTime?        @map("agreement_end_date") @db.Date
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  room     Room                 @relation(fields: [roomId], references: [id])
  rents    RentHistory[]
  readings ElectricityReading[]
  charges  Charge[]
  bills    Bill[]
  deposits SecurityDepositReceipt[]

  @@index([tenantId])
  @@index([roomId, status])
  @@map("room_assignments")
}

/// Effective-dated rent. Rent for a month = latest row with effective_from <= month start.
model RentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  assignmentId  String   @map("assignment_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  assignment RoomAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, effectiveFrom])
  @@map("rent_history")
}

model ElectricityReading {
  id              String   @id @default(uuid()) @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  billingPeriod   DateTime @map("billing_period") @db.Date
  previousReading Decimal  @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal  @map("current_reading") @db.Decimal(12, 2)
  units           Decimal  @db.Decimal(12, 2)
  ratePerUnit     Decimal  @map("rate_per_unit") @db.Decimal(8, 2)
  amount          Decimal  @db.Decimal(12, 2)
  isOverride      Boolean  @default(false) @map("is_override")
  billId          String?  @unique @map("bill_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  assignment RoomAssignment @relation(fields: [assignmentId], references: [id])
  bill       Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, billingPeriod])
  @@map("electricity_readings")
}

/// Recurring charge templates per assignment (e.g. maintenance 500 every month).
model Charge {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  type         ChargeType
  name         String
  amount       Decimal    @db.Decimal(12, 2)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  assignment RoomAssignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
  @@map("charges")
}

model Bill {
  id                 String     @id @default(uuid()) @db.Uuid
  billNumber         String     @unique @map("bill_number")
  propertyId         String     @map("property_id") @db.Uuid
  assignmentId       String     @map("assignment_id") @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  roomId             String     @map("room_id") @db.Uuid
  billingPeriod      DateTime   @map("billing_period") @db.Date
  dueDate            DateTime   @map("due_date") @db.Date
  status             BillStatus @default(GENERATED)
  rentAmount         Decimal    @map("rent_amount") @db.Decimal(12, 2)
  electricityAmount  Decimal    @map("electricity_amount") @db.Decimal(12, 2)
  otherChargesAmount Decimal    @map("other_charges_amount") @db.Decimal(12, 2)
  lateFee            Decimal    @default(0) @map("late_fee") @db.Decimal(12, 2)
  discount           Decimal    @default(0) @db.Decimal(12, 2)
  previousBalance    Decimal    @default(0) @map("previous_balance") @db.Decimal(12, 2)
  totalDue           Decimal    @map("total_due") @db.Decimal(12, 2)
  /// Maintained by the payments service; never changes totalDue.
  paidAmount         Decimal    @default(0) @map("paid_amount") @db.Decimal(12, 2)
  carriedForwardToId String?    @map("carried_forward_to_id") @db.Uuid
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  property   Property            @relation(fields: [propertyId], references: [id])
  assignment RoomAssignment      @relation(fields: [assignmentId], references: [id])
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  room       Room                @relation(fields: [roomId], references: [id])
  items      BillItem[]
  payments   Payment[]
  reading    ElectricityReading?

  // One non-cancelled bill per assignment and period is enforced by a partial unique index in the migration SQL.
  @@index([assignmentId, billingPeriod])
  @@index([propertyId, billingPeriod])
  @@index([tenantId, billingPeriod])
  @@index([status, dueDate])
  @@map("bills")
}

model BillItem {
  id          String       @id @default(uuid()) @db.Uuid
  billId      String       @map("bill_id") @db.Uuid
  type        BillItemType
  description String
  amount      Decimal      @db.Decimal(12, 2)
  sortOrder   Int          @default(0) @map("sort_order")
  meta        Json?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  billId      String        @map("bill_id") @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @map("payment_date") @db.Date
  method      PaymentMethod
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  /// Set on a reversal row (negative amount): the payment it undoes. Payments are never deleted.
  reversalOfId String?      @unique @map("reversal_of_id") @db.Uuid

  bill       Bill     @relation(fields: [billId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  reversalOf Payment? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy Payment? @relation("PaymentReversal")

  @@index([billId])
  @@index([tenantId])
  @@index([paymentDate])
  @@map("payments")
}

/// Security deposit received for a stay, one row per instalment. The agreed amount is RoomAssignment.securityDeposit.
model SecurityDepositReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  assignmentId String        @map("assignment_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  receivedOn   DateTime      @map("received_on") @db.Date
  method       PaymentMethod
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at")

  assignment RoomAssignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
  @@map("security_deposit_receipts")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
