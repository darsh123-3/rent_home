# ---------- Backend (apps/backend/.env) ----------
NODE_ENV=development
PORT=3000

# Supabase PostgreSQL. Use the pooled (port 6543, ?pgbouncer=true) URL for DATABASE_URL
# and the direct (port 5432) URL for DIRECT_URL (used by prisma migrate).
DATABASE_URL=postgresql://rent:rent@localhost:5432/room_rent
DIRECT_URL=postgresql://rent:rent@localhost:5432/room_rent

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket). Never expose these to the mobile app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=90

# First-run owner account created by `npm run db:seed`
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=ChangeMe123!

# Comma separated origins allowed by CORS (native apps send no Origin header)
CORS_ORIGINS=

# Number of reverse proxies in front of the API (Render, Railway, Fly, Nginx: 1). Leave 0 if exposed directly.
TRUST_PROXY=0

# Time zone for "today", bill "Issued on" dates and payment dates (default Asia/Kolkata). The server clock on Render is UTC.
APP_TIMEZONE=Asia/Kolkata

# ---------- Mobile (apps/mobile/.env) ----------
# Public configuration only. Never put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
